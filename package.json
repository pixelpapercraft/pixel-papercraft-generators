{
  "name": "pixel-papercraft-generators",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "next build --webpack",
    "start": "next start",
    "setup": "node scripts/setup.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "test:unit": "vitest run",
    "test:generators": "playwright test",
    "test:generators:update": "playwright test --update-snapshots=all",
    "test:generators:report": "playwright show-report",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src",
    "types:check": "tsc",
    "makeTextures": "tsx src/tools/makeTextures/makeTextures.ts",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "jspdf": "^4.2.1",
    "marked": "17.0.5",
    "next": "^16.3.3",
    "react": "18.3.1",
    "react-colorful": "^5.8.0",
    "react-dom": "18.3.1",
    "sharp": "^0.35.3",
    "uuid": "^14.0.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/typography": "0.5.15",
    "@types/node": "22.12.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.1.0",
    "@typescript-eslint/parser": "8.1.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.4",
    "husky": "^9.1.7",
    "imageinfo": "1.0.4",
    "jimp": "^1.6.0",
    "lint-staged": "^16.4.0",
    "postcss": "8.5.26",
    "prettier": "3.3.2",
    "tailwindcss": "3.4.15",
    "tsx": "^4.21.0",
    "typescript": "5.7.2",
    "vite": "^8.0.8",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss-load-config": "^6.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,md}": "prettier --write"
  }
}
